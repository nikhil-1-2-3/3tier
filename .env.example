# Logicwind Portal Environment Variables

# Backend Port
PORT=5000
NODE_ENV=development

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://logicwind_user:password@localhost:5433/logicwind_db?schema=public"

# JWT Authentication
JWT_SECRET="logicwind_production_ready_jwt_secret_key_minimum_32_characters_2026"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"
